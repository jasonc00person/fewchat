{
  "name": "fewchat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    // `npx wrangler d1 create fewchat` prints the id (SETUP.md step 3).
    { "binding": "DB", "database_name": "fewchat", "database_id": "REPLACE_D1_DATABASE_ID" }
  ],
  // Workers AI: Deepgram/Whisper transcribe voice notes (src/media.ts).
  "ai": { "binding": "AI" },
  // Autopilot sends run here: typing pauses outlast the ~30s a webhook's waitUntil gets, a queue job has minutes.
  // `npx wrangler queues create fewchat-send` once (SETUP.md step 3).
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "fewchat-send" }],
    "consumers": [{ "queue": "fewchat-send", "max_batch_size": 10, "max_batch_timeout": 1 }]
  },
  // Real-time Inbox: one Durable Object holds the open tabs' WebSockets and gets pinged on every change (src/live.ts).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],
  // Every minute: draft replies for threads that went quiet, send due autopilot drafts, expire stale ones.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // The join link the setter sends (Settings in the console can override it later).
    "SKOOL_LINK": "https://www.skool.com/REPLACE-SKOOL-SLUG/about",
    // Off until you've watched it on test threads; the console's AI switch flips it without a deploy.
    "AUTOPILOT": "false",
    // Autopilot send delay after drafting; capped at 5s anyway (Meta: automated replies within 30s).
    "REPLY_DELAY_MIN_S": "2",
    "REPLY_DELAY_MAX_S": "5",
    "TRANSPORT": "meta",
    // Autopilot sends look typed: seen, typing dots, a pause sized to each bubble (src/setter.ts deliver).
    "TYPING": "true",
    // Meta dashboard → your app → Instagram → API setup with Instagram login → "Instagram app ID" (SETUP.md step 5).
    "META_IG_APP_ID": "REPLACE_INSTAGRAM_APP_ID"
  }
  // Secrets (npx wrangler secret put <NAME>, never in this file): ANTHROPIC_API_KEY, INBOUND_SECRET, ADMIN_PASSWORD,
  // META_APP_SECRET (Instagram app secret), META_VERIFY_TOKEN; optional REVIEW_PASSWORD, SKOOL_AUTH_TOKEN, ALERT_TOPIC,
  // MANYCHAT_API_KEY (only if you also run Manychat, see CLAUDE.md "Manychat").
}
